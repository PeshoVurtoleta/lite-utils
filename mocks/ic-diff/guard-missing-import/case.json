{
  "tool": "ic-diff.sh",
  "mode": "diff",
  "class": "after side cannot load its module graph (sibling ./dep.mjs not staged) (b125 U0)",
  "kind": "guard",
  "claim": "ic-diff -h: a driver that exits non-zero is NO-VERDICT (driver exited <rc> in run <k>), never a 0-site side",
  "files": {
    "before": {
      "src": "program.mjs",
      "dir": "b"
    },
    "before_dep": {
      "src": "dep.mjs",
      "dir": "b",
      "name": "dep.mjs"
    },
    "after": {
      "src": "program.mjs",
      "dir": "a"
    }
  },
  "argv": [
    "--node",
    "{node}",
    "--fn",
    "get",
    "--v8-flags",
    "--no-lazy-feedback-allocation",
    "{before}",
    "{after}"
  ],
  "expect": {
    "verdict": "NO-VERDICT",
    "text": [
      [
        "get:",
        "NO-VERDICT",
        "after:",
        "driver exited 1 in run 1"
      ]
    ],
    "forbid": [
      "NO-VERDICT -- before:"
    ]
  },
  "expect_by_major": {
    "22": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    },
    "24": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    }
  }
}
