{
  "tool": "ic-diff.sh",
  "mode": "diff",
  "class": "target function never called has no IC site (IC-G2)",
  "kind": "guard",
  "claim": "ic-diff -h: no IC site of fn -> NO-VERDICT",
  "files": {
    "before": "program.mjs",
    "after": "program.mjs"
  },
  "argv": [
    "--node",
    "{node}",
    "--fn",
    "get",
    "--v8-flags",
    "--no-lazy-feedback-allocation",
    "{before}",
    "{after}"
  ],
  "expect": {
    "verdict": "NO-VERDICT",
    "text": [
      [
        "get:",
        "NO-VERDICT",
        "no IC site"
      ]
    ]
  },
  "expect_by_major": {
    "22": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    },
    "24": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    }
  }
}
