{
  "tool": "ic-diff.sh",
  "mode": "diff",
  "class": "two same-key IC sites swapping mono/poly states reads SAME (IC-L1)",
  "kind": "limit",
  "claim": "ic-diff -h: not detected -- two sites of fn that swap states (key has no line:col) read SAME",
  "files": {
    "before": "before.mjs",
    "after": "after.mjs"
  },
  "argv": [
    "--node",
    "{node}",
    "--fn",
    "get",
    "--v8-flags",
    "--no-lazy-feedback-allocation",
    "{before}",
    "{after}"
  ],
  "expect": {
    "verdict": "SAME",
    "text": [
      [
        "get:",
        "SAME"
      ],
      [
        "(before 2 | after 2 site(s))"
      ]
    ]
  },
  "expect_by_major": {
    "22": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    },
    "24": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "NO-VERDICT",
          "code kind outside the allowlist"
        ]
      ]
    }
  }
}
