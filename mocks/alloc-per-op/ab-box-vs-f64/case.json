{
  "tool": "alloc-per-op.mjs",
  "mode": "apoab",
  "class": "A/B diff between boxing lane and zero-alloc lane (AP-C3)",
  "kind": "change",
  "claim": "alloc-per-op -h: A/B --tol when peak delta exceeds tolerance -> DIFF",
  "files": {
    "a": {
      "src": "bench-a.mjs",
      "dir": "a",
      "name": "bench.mjs"
    },
    "b": {
      "src": "bench-b.mjs",
      "dir": "b",
      "name": "bench.mjs"
    }
  },
  "argv": [
    "--n",
    "1000000",
    "--windows",
    "3",
    "--warm",
    "100000",
    "--tol",
    "2",
    "{a}",
    "{b}"
  ],
  "expect": {
    "verdict": "DIFF",
    "text": [
      [
        "hot",
        "DIFF"
      ]
    ]
  }
}
