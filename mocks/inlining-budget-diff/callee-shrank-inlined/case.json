{
  "tool": "inlining-budget-diff.sh",
  "mode": "diff",
  "class": "callee shrank under max-inlined bytecode limit (IB-C2)",
  "kind": "change",
  "claim": "inlining-budget-diff -h: callee newly inlined after shrinking below limit -> DIFF",
  "files": {
    "before": "before.mjs",
    "after": "after.mjs"
  },
  "argv": [
    "--node",
    "{node}",
    "--fn",
    "m0",
    "--out",
    "{out}",
    "{before}",
    "{after}"
  ],
  "expect": {
    "verdict": "DIFF",
    "text": [
      [
        "guard ok:",
        "m0"
      ],
      [
        "before=",
        "Inlining 0x",
        "SharedFunctionInfo g>"
      ]
    ]
  },
  "expect_by_major": {
    "22": {
      "verdict": "NO-VERDICT",
      "text": [
        [
          "guard ok:",
          "m0"
        ],
        [
          "before=",
          "Inlining 0x",
          "SharedFunctionInfo g>"
        ],
        [
          "=== maglev: NO-VERDICT",
          "no inlining decisions at all",
          "does not run Maglev by default"
        ]
      ]
    }
  }
}
